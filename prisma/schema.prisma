// Database schema for Ember & Oak Coffee Roasters.
// Money is always stored as integer cents to avoid floating-point rounding.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  COFFEE
  BUNDLE
  ACCESSORY
}

enum RoastLevel {
  LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

enum Acidity {
  LOW
  MEDIUM
  HIGH
}

enum BrewMethod {
  ESPRESSO
  FILTER
  FRENCH_PRESS
  COLD_BREW
}

model Product {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  type         ProductType
  tagline      String
  description  String
  priceCents   Int
  stock        Int
  weightGrams  Int?
  origin       String?
  region       String?
  process      String?
  tastingNotes String[]
  roastLevel   RoastLevel?
  acidity      Acidity?
  brewMethods  BrewMethod[]
  imageUrl     String
  imageAlt     String
  featured     Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archived Boolean @default(false)
  sample Boolean @default(true)
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id])
  collection String @default("Essentials")
  tags String[] @default([])
  composition String @default("")
  fit String @default("")
  care String @default("")
  sizeChart Json @default("[]")
  salePriceCents Int?
  saleStartsAt DateTime?
  saleEndsAt DateTime?
  popularity Int @default(0)
  variants ProductVariant[]
  images ProductImage[]
  orderItems   OrderItem[]
  recommendations ChatRecommendation[]

  @@index([type])
  @@index([roastLevel])
  @@index([categoryId, archived, createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_REVIEW
  EXPIRED
  SHIPPED
  DELIVERED
}

model Order {
  id                String      @id @default(cuid())
  number            String      @unique
  checkoutKey       String      @unique
  requestHash       String
  status            OrderStatus @default(PENDING)
  email             String?
  customerName      String?
  shippingAddress   Json?
  stripeSessionId   String?     @unique
  paymentIntentId   String?     @unique
  subtotalCents     Int
  shippingCents     Int
  totalCents        Int
  currency          String      @default("usd")
  checkoutOrigin    String
  trackingNumber    String?
  paidAt            DateTime?
  emailSentAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  events            StripeEvent[]

  @@index([email, number])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  name           String
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  size String?
  color String?
  sku String?
  grind          String?
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
}

// The event and its business changes commit together, or neither commits.
model StripeEvent {
  id          String   @id
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processedAt DateTime @default(now())
}

// Shared across serverless instances; no customer email or raw IP is stored here.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Conversation {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  messageCount    Int      @default(0)
  costMicrousd    Int      @default(0)
  activeRequestId String?
  leaseUntil      DateTime @default(now())
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        ChatMessage[]
  leads           Lead[]

  @@index([createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId       String
  role            ChatRole
  content         String
  topic           String?
  createdAt       DateTime     @default(now())
  recommendations ChatRecommendation[]

  @@unique([conversationId, requestId, role])
  @@index([conversationId, createdAt])
}

model ChatRecommendation {
  id            String      @id @default(cuid())
  messageId     String
  message       ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  addedToCartAt DateTime?
  createdAt     DateTime    @default(now())

  @@unique([messageId, productId])
  @@index([productId])
}

enum LeadStatus {
  OPEN
  CONTACTED
  CLOSED
}

// Opaque owner sessions. Raw tokens never enter the database.
model AdminSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  secretHash String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

model Lead {
  id             String        @id @default(cuid())
  requestId      String        @unique
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  name           String
  email          String
  question       String
  status         LeadStatus    @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

// A successful UTC day is recorded in the same transaction as its cleanup.
model DemoCleanupRun {
  day                  String   @id
  completedAt          DateTime @default(now())
  cutoff               DateTime
  deletedOrders        Int      @default(0)
  deletedLeads         Int      @default(0)
  deletedConversations Int      @default(0)
  restoredProducts     Int      @default(0)
}

model Category {
 id String @id @default(cuid())
 slug String @unique
 name String
 imageUrl String @default("")
 sortOrder Int @default(0)
 products Product[]
}
model ProductVariant {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 sku String @unique
 size String
 color String
 colorHex String
 stock Int @default(0)
 active Boolean @default(true)
 orderItems OrderItem[]
 @@unique([productId, size, color])
 @@index([productId, active, stock])
}
model ProductImage {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 url String
 alt String
 color String?
 position Int @default(0)
 storageKey String?
 @@index([productId, position])
}
model Coupon {
 code String @id
 percent Int
 active Boolean @default(true)
 expiresAt DateTime
 minimumCents Int @default(0)
}
model StoreSettings {
 id String @id @default("store")
 name String @default("AUREO")
 slogan String @default("O essencial tem presença.")
 announcement String @default("Coleção 01 — Uma nova forma de vestir o cotidiano")
 heroImage String @default("/images/editorial.jpg")
 heroTitle String @default("Menos excesso. Mais essência.")
 accent String @default("#151515")
 privacyDraft String @default("Rascunho: definir responsável, contato, finalidades, prazos de retenção e canal para direitos dos titulares antes da publicação.")
 shippingDraft String @default("Rascunho: condições e prazos serão definidos após a integração com a transportadora. Não há entregas reais nesta demonstração.")
 returnsDraft String @default("Rascunho: publicar os procedimentos de trocas e devoluções após revisão jurídica e operacional.")
 termsDraft String @default("Rascunho: esta loja está em desenvolvimento. Produtos ilustrativos e pagamentos reais desativados.")
}
model NewsletterSubscriber {
 id String @id @default(cuid())
 email String @unique
 consentVersion String
 consentAt DateTime @default(now())
 unsubscribeToken String @unique @default(uuid())
}
